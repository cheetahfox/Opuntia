From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Opuntia <build@opuntia.net>
Date: Mon, 22 Jun 2026 00:00:00 +0000
Subject: [PATCH] v2ray-geodata: remove @ from PROVIDES for apk compatibility

The APK builder rejects @-prefixed provides values as invalid
dependency format. Strip the @ prefix from PROVIDES in all three
subpackages (v2ray-geoip, v2ray-geosite, v2ray-geosite-ir).

Fixes: ERROR: info field 'provides' has invalid value: dependency
format is invalid

---
 feeds/packages/net/v2ray-geodata/Makefile | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/feeds/packages/net/v2ray-geodata/Makefile b/feeds/packages/net/v2ray-geodata/Makefile
index 1234567..abcdefg 100644
--- a/feeds/packages/net/v2ray-geodata/Makefile
+++ b/feeds/packages/net/v2ray-geodata/Makefile
@@ -50,7 +50,7 @@ endef
 define Package/v2ray-geoip
   $(call Package/v2ray-geodata/template)
   TITLE:=GeoIP List for V2Ray
-  PROVIDES:=@v2ray-geodata @xray-geodata @xray-geoip
+  PROVIDES:=v2ray-geodata xray-geodata xray-geoip
   VERSION:=$(GEOIP_VER)-r$(PKG_RELEASE)
   LICENSE:=CC-BY-SA-4.0
 endef
@@ -58,7 +58,7 @@ endef
 define Package/v2ray-geosite
   $(call Package/v2ray-geodata/template)
   TITLE:=Geosite List for V2Ray
-  PROVIDES:=@v2ray-geodata @xray-geodata @xray-geosite
+  PROVIDES:=v2ray-geodata xray-geodata xray-geosite
   VERSION:=$(GEOSITE_VER)-r$(PKG_RELEASE)
   LICENSE:=MIT
 endef
@@ -66,7 +66,7 @@ endef
 define Package/v2ray-geosite-ir
   $(call Package/v2ray-geodata/template)
   TITLE:=Iran Geosite List for V2Ray
-  PROVIDES:=@xray-geosite-ir
+  PROVIDES:=xray-geosite-ir
   VERSION:=$(GEOSITE_IRAN_VER)-r$(PKG_RELEASE)
   LICENSE:=MIT
 endef
-- 
2.39.0
